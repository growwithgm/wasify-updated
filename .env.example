# ============================================================================
# WASIFY — environment variables
# Copy to .env.local for local dev; set the same keys in Vercel → Settings →
# Environment Variables for production.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase  (Project Settings → API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only. Bypasses RLS — never expose it to the browser and never
# prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# Token encryption
# ---------------------------------------------------------------------------
# 64 hex characters = 32 bytes. Generate with:  openssl rand -hex 32
# Encrypts every stored WhatsApp and Shopify token (AES-256-GCM).
# NEVER change this after tokens are saved — they become undecryptable.
# Use the SAME value in every environment that shares a database.
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Meta / WhatsApp Cloud API
# ---------------------------------------------------------------------------
# App Dashboard → Settings → Basic → App Secret.
# REQUIRED: without it the webhook refuses all traffic, because an unverified
# webhook would let anyone who knows the URL inject messages into your inbox.
META_APP_SECRET=

# ---------------------------------------------------------------------------
# Shopify (Partner Dashboard → your app → Client credentials)
# ---------------------------------------------------------------------------
# Also required — the same fail-closed rule applies to the Shopify webhook.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Public base URL
# ---------------------------------------------------------------------------
# Builds the OAuth redirect_uri and the webhook callback URLs, so it must be
# your real public origin with no trailing slash. Set it explicitly on Vercel —
# do not rely on the auto-generated preview URL.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# Cron authentication
# ---------------------------------------------------------------------------
# You invent these — nothing issues them. Generate with: openssl rand -hex 24
#
# Set ONE of the two. They are equivalent, but each pairs with a DIFFERENT
# header, and mixing them is the usual cause of a silent 401 from a scheduler:
#
#   CRON_SECRET             ->  Authorization: Bearer <value>
#   AUTOMATION_CRON_SECRET  ->  x-cron-secret: <value>
#
# /api/health reports which one it found and the exact header to send.
# If neither is set, the cron endpoints refuse every request.
CRON_SECRET=
AUTOMATION_CRON_SECRET=

# ---------------------------------------------------------------------------
# Shopify Flow
# ---------------------------------------------------------------------------
# Authenticates the "Send HTTP request" action that Shopify Flow fires on
# Order created (POST /api/flow/order-confirmation). You invent it, same as
# the cron secrets: openssl rand -hex 24. Flow must send it as
#   Authorization: Bearer <value>
# Unset, the endpoint refuses all traffic (503) — fail closed, like webhooks.
FLOW_SECRET=
